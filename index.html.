
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Tech Store | Premium Electronics</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #080d18;
    color: white;
}

header {
    background: #101a2b;
    padding: 22px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

.logo {
    font-size: 27px;
    font-weight: bold;
    color: #00c8ff;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 12px;
}

.cart {
    background: #00aaff;
    padding: 12px 18px;
    border-radius: 8px;
}

.hero {
    text-align: center;
    padding: 100px 20px;
    background: linear-gradient(135deg, #101a2b, #003b65);
}

.hero h1 {
    font-size: 48px;
    margin-bottom: 20px;
}

.hero p {
    color: #c5d4e8;
    font-size: 18px;
    margin-bottom: 30px;
}

.hero button {
    background: #00bfff;
    color: white;
    border: none;
    padding: 15px 30px;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
}

.search {
    text-align: center;
    padding: 35px 15px;
}

.search input {
    width: 80%;
    max-width: 500px;
    padding: 15px;
    border-radius: 8px;
    border: none;
    font-size: 16px;
}

.products {
    padding: 30px 8% 70px;
}

.products h2 {
    text-align: center;
    font-size: 32px;
    margin-bottom: 35px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 25px;
}

.card {
    background: #142238;
    border: 1px solid #263b58;
    border-radius: 15px;
    overflow: hidden;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-8px);
    border-color: #00bfff;
}

.card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.info {
    padding: 20px;
}

.info h3 {
    margin-bottom: 12px;
}

.price {
    color: #00d4ff;
    font-size: 23px;
    font-weight: bold;
    margin: 15px 0;
}

.card button {
    background: #008fce;
    color: white;
    border: none;
    padding: 12px;
    width: 100%;
    border-radius: 7px;
    cursor: pointer;
    font-size: 15px;
}

.card button:hover {
    background: #00bfff;
}

footer {
    background: #101a2b;
    text-align: center;
    padding: 30px;
    color: #9db1ca;
}

@media(max-width: 600px) {
    .hero h1 {
        font-size: 34px;
    }

    header {
        justify-content: center;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">TECH STORE</div>

    <nav>
        <a href="#">Home</a>
        <a href="#products">Products</a>
        <a href="#contact">Contact</a>
    </nav>

    <div class="cart">
        🛒 Cart: <span id="count">0</span>
    </div>
</header>

<section class="hero">
    <h1>Welcome to Tech Store</h1>
    <p>Discover the latest technology at amazing prices.</p>
    <button onclick="document.getElementById('products').scrollIntoView()">
        Shop Now
    </button>
</section>

<section class="search">
    <input
        type="text"
        id="search"
        placeholder="Search products..."
        oninput="searchProducts()"
    >
</section>

<section class="products" id="products">
    <h2>Our Products</h2>

    <div class="grid" id="productGrid">

        <div class="card">
            <img src="https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=600" alt="Laptop">
            <div class="info">
                <h3>Premium Laptop</h3>
                <p>Powerful laptop for work and gaming.</p>
                <div class="price">$850</div>
                <button onclick="addToCart()">Add to Cart</button>
            </div>
        </div>

        <div class="card">
            <img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=600" alt="Smartphone">
            <div class="info">
                <h3>Smartphone</h3>
                <p>Modern smartphone with amazing features.</p>
                <div class="price">$650</div>
                <button onclick="addToCart()">Add to Cart</button>
            </div>
        </div>

        <div class="card">
            <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600" alt="Headphones">
            <div class="info">
                <h3>Wireless Headphones</h3>
                <p>High-quality sound and comfortable design.</p>
                <div class="price">$120</div>
                <button onclick="addToCart()">Add to Cart</button>
            </div>
        </div>

        <div class="card">
            <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600" alt="Smart Watch">
            <div class="info">
                <h3>Smart Watch</h3>
                <p>Track your fitness and stay connected.</p>
                <div class="price">$180</div>
                <button onclick="addToCart()">Add to Cart</button>
            </div>
        </div>

        <div class="card">
            <img src="https://images.unsplash.com/photo-1527864550417-7fd91fc51a46?w=600" alt="Mouse">
            <div class="info">
                <h3>Gaming Mouse</h3>
                <p>Professional gaming mouse.</p>
                <div class="price">$45</div>
                <button onclick="addToCart()">Add to Cart</button>
            </div>
        </div>

        <div class="card">
            <img src="https://images.unsplash.com/photo-1583394838336-acd977736f90?w=600" alt="Earbuds">
            <div class="info">
                <h3>Wireless Earbuds</h3>
                <p>Enjoy music wherever you go.</p>
                <div class="price">$75</div>
                <button onclick="addToCart()">Add to Cart</button>
            </div>
        </div>

    </div>
</section>

<footer id="contact">
    <h3>TECH STORE</h3>
    <p>Your trusted technology store.</p>
    <p>© 2026 Tech Store. All Rights Reserved.</p>
</footer>

<script>
let cartCount = 0;

function addToCart() {
    cartCount++;
    document.getElementById("count").textContent = cartCount;
    alert("Product added to cart!");
}

function searchProducts() {
    let search = document.getElementById("search").value.toLowerCase();
    let cards = document.querySelectorAll(".card");

    cards.forEach(card => {
        let name = card.querySelector("h3").textContent.toLowerCase();

        card.style.display = name.includes(search) ? "block" : "none";
    });
}
</script>

</body>
</html>
